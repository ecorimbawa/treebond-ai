# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/treebond-ai?retryWrites=true&w=majority

# NextAuth (Auth.js v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Blockchain
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Smart Contracts (Arbitrum Sepolia deploy — see Log-Deploy-ABI doc)
NEXT_PUBLIC_TREE_NFT_ADDRESS=0xEE073d076cdB6Da047fAd2CD62e4d6EF0120F71f
NEXT_PUBLIC_TREE_REGISTRY_ADDRESS=0x80Bf32F0cD043Df3F191fc2c712e5Ab76Bf7B38A
NEXT_PUBLIC_TREE_BOND_ADDRESS=0x57A60e3693f2846f4e7c9B0109c4EFE07135204f
NEXT_PUBLIC_VERIFICATION_REGISTRY_ADDRESS=0x5894358cB440BBf2dC7b723696c648E384EbC3A4

# IPFS
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs
IPFS_API_URL=
IPFS_API_KEY=
IPFS_API_SECRET=

# AI Service
AI_API_KEY=

# Oracle (server-side only) — must hold ORACLE_ROLE on VerificationRegistry
ORACLE_PRIVATE_KEY=

# No ADMIN_PRIVATE_KEY: granting OPERATOR_ROLE/VERIFIER_ROLE from /admin is
# signed by whichever wallet the admin connects in-browser (must hold
# DEFAULT_ADMIN_ROLE on TreeRegistry) — same client-side pattern as every
# other write in this app, not a server-held key.
